#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
real_mix=""
started_postgres=0

devenv_from_repo_root() {
  (cd "$repo_root" && devenv "$@")
}

use_devenv_processes() {
  [ "${MEMBA_NATIVE_DEVCONTAINER:-}" != "1" ] && command -v devenv >/dev/null 2>&1
}

wait_for_native_postgres() {
  local host="${PGHOST:-localhost}"
  local port="${PGPORT:-${MEMBA_POSTGRES_PORT:-5432}}"

  for _ in $(seq 1 120); do
    if pg_isready -h "$host" -p "$port" >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done

  echo "Postgres did not become ready at PGHOST=$host PGPORT=$port" >&2
  exit 1
}

ensure_postgres() {
  if [ -z "${PGHOST:-}" ] || [ -z "${PGPORT:-}" ]; then
    return
  fi

  if pg_isready -h "$PGHOST" -p "$PGPORT" >/dev/null 2>&1; then
    return
  fi

  if ! use_devenv_processes; then
    wait_for_native_postgres
    return
  fi

  # `devenv shell mix precommit` runs this wrapper without automatically
  # starting declared services, but the precommit/test aliases need Postgres for
  # Ecto and EventStore setup.
  devenv_from_repo_root processes down >/dev/null 2>&1 || true
  DEVENV_TUI=false devenv_from_repo_root processes up --strict-ports -d postgres
  started_postgres=1
  devenv_from_repo_root processes wait --timeout 120

  if ! pg_isready -h "$PGHOST" -p "$PGPORT" >/dev/null 2>&1; then
    devenv_from_repo_root processes logs -n 100 postgres >&2 || true
    echo "Postgres did not become ready at PGHOST=$PGHOST PGPORT=$PGPORT" >&2
    exit 1
  fi
}

cleanup_started_postgres() {
  if [ "$started_postgres" = 1 ] && use_devenv_processes; then
    devenv_from_repo_root processes down >/dev/null 2>&1 || true
  fi
}

case "${1:-}" in
  precommit|test|ecto.*|event_store.*)
    trap cleanup_started_postgres EXIT
    ensure_postgres
    ;;
esac

while IFS= read -r candidate; do
  if [ "$candidate" != "$repo_root/bin/mix" ]; then
    real_mix="$candidate"
    break
  fi
done < <(which -a mix)

if [ -z "$real_mix" ]; then
  echo "Could not find the Elixir mix executable" >&2
  exit 1
fi

cd "$repo_root/web"
"$real_mix" "$@"
