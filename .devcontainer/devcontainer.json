{
  "name": "memba",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/memba",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "./features/agent-clis": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/setup-agents.sh",
  "containerEnv": {
    "ANTHROPIC_BASE_URL": "https://opencode.ai/zen",
    "ANTHROPIC_MODEL": "claude-opus-4-8",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "FONTCONFIG_FILE": "/etc/fonts/fonts.conf",
    "FONTCONFIG_PATH": "/etc/fonts",
    "HEX_CACERTS_PATH": "/etc/ssl/certs/ca-certificates.crt",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "MIX_ESBUILD_PATH": "/usr/local/bin/esbuild",
    "MIX_TAILWIND_PATH": "/usr/local/bin/tailwindcss",
    "NODE_PATH": "/usr/local/lib/node_modules",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    "TERM": "xterm-256color",
    "COLORTERM": "truecolor"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [
    4000,
    4002
  ],
  "portsAttributes": {
    "4000": {
      "label": "Phoenix dev server",
      "onAutoForward": "notify"
    },
    "4002": {
      "label": "Phoenix acceptance server",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "elixir-lsp.elixir-ls",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "claudeCode.disableLoginPrompt": true,
        "claudeCode.selectedModel": "claude-opus-4-8",
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontFamily": "'Cascadia Mono', 'Cascadia Code', 'DejaVu Sans Mono', 'Noto Sans Mono', 'Liberation Mono', monospace"
      }
    }
  },
  "remoteUser": "vscode"
}
