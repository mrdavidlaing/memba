{
  "name": "memba",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/memba",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "onCreateCommand": ["bash", ".devcontainer/install-elixir-deps.sh"],
  "updateContentCommand": {
    "web-assets": ["bash", ".devcontainer/build-web-assets.sh"],
    "acceptance": ["bash", ".devcontainer/install-acceptance-deps.sh"]
  },
  "postStartCommand": ["bash", ".devcontainer/configure-agents.sh"],
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [
    4000,
    4002
  ],
  "portsAttributes": {
    "4000": {
      "label": "Phoenix dev server",
      "onAutoForward": "notify"
    },
    "4002": {
      "label": "Phoenix acceptance server",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "elixir-lsp.elixir-ls",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "claudeCode.disableLoginPrompt": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontFamily": "'Cascadia Mono', 'Cascadia Code', 'DejaVu Sans Mono', 'Noto Sans Mono', 'Liberation Mono', monospace"
      }
    }
  },
  "remoteUser": "vscode"
}
